{
  "regions": ["sin1"],
  "functions": {
    "src/app/api/ai/**/*": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/cron/**/*": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/opportunity-discovery",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}